{
  "name": "springware-ive",
  "version": "1.18.1",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "prebuild": "node scripts/generate-third-party-notices.mjs",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "postinstall": "node -e \"const os=require('os'),fs=require('fs'),path=require('path');const h=path.join('node_modules','node-pty','prebuilds',os.platform()+'-'+os.arch(),'spawn-helper');try{fs.chmodSync(h,'755');console.log('node-pty spawn-helper: chmod 755 ok')}catch(e){}\"",
    "docker:build": "docker build -t dazzlepf/springware-ive .",
    "docker:push": "docker push dazzlepf/springware-ive:latest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy": "npm run docker:build && npm run docker:push",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
